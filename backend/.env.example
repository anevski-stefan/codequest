# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Client (frontend) URL used for post-auth redirects
CLIENT_URL=http://localhost:5173

# Server Configuration
NODE_ENV=development
PORT=3000

# Trust proxy hops for correct client IP when running behind a reverse proxy (nginx/load balancer).
# Required in production so rate limiting keys off the real client IP, not the proxy IP.
# Set to the number of proxy hops (e.g. 1), 'true', or 'false' to disable.
TRUST_PROXY=0

# Supabase (REQUIRED for authentication - access tokens are stored server-side here)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Session Configuration
SESSION_SECRET=your_secure_session_secret_here
# Session cookie max age in milliseconds (default 24h = 86400000)
SESSION_MAX_AGE_MS=86400000
# Session persistence backend: 'memory' (default, dev only - lost on restart) or 'supabase'.
# Use 'supabase' in production (restart-safe, multi-instance). Requires the sessions table
# migration (backend/supabase/migrations/20260901120000_add_sessions_table.sql) be applied first.
SESSION_STORE=memory
# Table name used by the Supabase session store (default 'sessions').
# SESSION_TABLE=sessions

# Allowed CORS origins (comma-separated). Falls back to CLIENT_URL then localhost.
ALLOWED_ORIGINS=http://localhost:5173

# Encryption key for at-rest user AI keys (REQUIRED in production)
AI_KEY_SECRET=your_secure_ai_key_secret_here

# Optional: override the NON-SECRET scrypt salt used only to decrypt records created
# before random per-record salts were introduced. Only set this if you must match
# historic data from a prior deployment. New records always use a random salt.
# AI_KEY_LEGACY_SALT=

# Admin email allowlist (comma-separated). Users listed here can create/edit/delete hackathons.
ADMIN_EMAILS=admin@example.com

# Mailchimp Configuration (Optional)
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_mailchimp_list_id
MAILCHIMP_SERVER=your_mailchimp_server

# Code Buddy / AI Service Configuration (Optional, sane defaults)
# Model IDs and endpoints used by the chat assistant
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://models.inference.ai.azure.com
GEMINI_MODEL=gemini-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Sampling temperature and token budgets for generated replies
AI_TEMPERATURE=0.7
CHATGPT_MAX_TOKENS=2048
GEMINI_MAX_TOKENS=1000
# Comma-separated GitHub labels used to surface beginner-friendly issues
GITHUB_ISSUE_LABELS=good-first-issue,"good first issue",help-wanted,beginner

# Hackathon crawl schedule (cron expression; default every 6 hours)
HACKATHON_CRAWL_CRON=0 */6 * * *

# Structured logging level: debug | info | warn | error (default info)
LOG_LEVEL=info 